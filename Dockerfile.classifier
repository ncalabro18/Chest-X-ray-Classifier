# Generates the classifier image
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Create a non-root user
RUN useradd --create-home --shell /usr/sbin/nologin appuser

# Install runtime dependencies first for better layer caching
COPY requirements_classifier.txt /app/requirements_classifier.txt
RUN pip install --no-cache-dir -r /app/requirements_classifier.txt

# Copy application code
COPY --chown=appuser:appuser frontend/public/per_epoch.csv per_epoch.csv
COPY --chown=appuser:appuser frontend/public/per_class.csv per_class.csv
COPY --chown=appuser:appuser classifier.py /app/classifier.py
COPY --chown=appuser:appuser classes.py /app/classes.py
COPY --chown=appuser:appuser dataset.py /app/dataset.py
COPY --chown=appuser:appuser dataloader.py /app/dataloader.py
COPY --chown=appuser:appuser architecture.py /app/architecture.py
COPY --chown=appuser:appuser swin_transformer_v2.py /app/swin_transformer_v2.py
COPY --chown=appuser:appuser visualization_util.py /app/visualization_util.py
COPY --chown=appuser:appuser util.py /app/util.py

# Copy best checkpoint file
COPY --chown=appuser:appuser swin_cxr8_best.pth /app/swin_cxr8_best.pth


USER appuser

EXPOSE 9000

HEALTHCHECK --interval=20s --timeout=10s --retries=3 --start-period=120s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9000/ready')" || exit 1


CMD ["python", "classifier.py"]